            <GradientStop Color="#94FFFFFF" Offset="1" />
        </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="2" Direction="270" Opacity="0.25" Color="#FF15283C" />
    </Border.Effect>
    <StackPanel Margin="22,15,22,16">
            <TextBlock FontWeight="Bold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="#FF233347" Text="关于" Tag="egglogo" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF233347"
                   Text="这是什么" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="给 IMC.RE 服务器做的 PCL2 主页：把服务器实时状态、按版本进服、陶瓦联机都搬进启动器，打开就能看到，点一下就能进服，不用再开网页。" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF233347"
                   Text="功能介绍" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="· 服务器状态：在线 / 离线、MOTD、版本、在线人数、延迟，每秒刷新" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="· 按版本进服：1.8 ~ 1.21.11 每个版本一行，「正版」连 on.imc.cab，「离线」连 off.imc.cab" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="· 联机 · 陶瓦：创建房间 / 复制联机码 / 加入房间 / 关闭联机，全程不弹网页；本机没装陶瓦时首次使用会自动下载安装" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="· 毛玻璃卡片：去掉 PCL 卡片自带的白底，能透出启动器背景图" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="· 折叠卡：版本列表、赞赏码都可以点标题 / 按钮收起，页面刷新时折叠状态不会丢" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF233347"
                   Text="怎么用" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="1. 解压发布包，双击「启动主页服务（无窗口）.vbs」（占 8848 端口，无窗口）" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="2. 打开「改版PCL」里的启动器；用你自己的 PCL 就先运行一次「PCL2-主页补丁安装器」" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="3. 想开机自启，双击一次「安装开机自启.bat」" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF233347"
                   Text="原理" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="页面 XAML 本身恒定不变，补丁每 0.5 秒从本机服务的 live.json 取数据，只改带 live 标记的控件，所以 PCL 不会重建页面，折叠和滚动都不会被打断。按钮通过 act 标记由补丁接管，直接调用陶瓦的本地接口。" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF233347"
                   Text="关于授权" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="改版PCL 里的启动器基于官方开源版 PCL2 构建：没有修改 PCL 源码，只在初始化处注入一次补丁、并替换内置预设的主页。PCL 版权属于其作者。" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="主页服务、注入补丁、页面与安装器的源码使用 MIT 授权。" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF233347"
                   Text="制作过程中使用的 AI" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="· 模型：DeepSeek-V4.1-Flash" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="· 工具：DeepSeek Harness（DeepSeek 的编码代理）" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF233347"
                   Text="页面 XAML、主页服务（Python）、注入补丁（C#）都在 AI 协作下完成；需求、测试与验收由人负责。" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF233347"
                   Text="反馈" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,0" Foreground="#FF6B7885" FontSize="12"
                   Text="有问题或想法，欢迎到上面的 QQ 群，或直接加 QQ 177436529 反馈。" />
    </StackPanel>
</Border>

